
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <!-- ENCABEZADO -->
    <div class="mb-4">
        <h2>Dashboard</h2>
        <p class="text-muted">
            Resumen de ventas y operaciones de la empresa.
        </p>
    </div>


    <!-- =========================================
         ESTADO ACTUAL DE LA EMPRESA
         ========================================= -->

    <h5 class="mb-3">Estado actual de la empresa</h5>

    <div class="row g-3 mb-4">

        <!-- PRODUCTOS ACTIVOS -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h6 class="text-muted">Productos activos</h6>

                    <h3 id="productosActivos">0</h3>

                    <small class="text-muted">
                        Estado actual del catálogo
                    </small>

                </div>
            </div>
        </div>

        <!-- MAYORISTAS PENDIENTES -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h6 class="text-muted">Mayoristas pendientes</h6>

                    <h3 id="solicitudesPendientes">0</h3>

                    <small class="text-muted">
                        Solicitudes pendientes actualmente
                    </small>

                </div>
            </div>
        </div>

    </div>


    <!-- =========================================
         ANÁLISIS DE VENTAS POR PERÍODO
         ========================================= -->

    <h5 class="mb-3">Análisis de ventas por período</h5>

    <!-- FILTROS -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-md-3">
                    <label class="form-label">Año</label>

                    <select id="anio" class="form-select">
                        @for (int a = DateTime.Now.Year; a >= DateTime.Now.Year - 4; a--)
                        {
                            <option value="@a">@a</option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Mes</label>

                    <select id="mes" class="form-select">
                        <option value="">Todos los meses</option>
                        <option value="1">Enero</option>
                        <option value="2">Febrero</option>
                        <option value="3">Marzo</option>
                        <option value="4">Abril</option>
                        <option value="5">Mayo</option>
                        <option value="6">Junio</option>
                        <option value="7">Julio</option>
                        <option value="8">Agosto</option>
                        <option value="9">Septiembre</option>
                        <option value="10">Octubre</option>
                        <option value="11">Noviembre</option>
                        <option value="12">Diciembre</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="button"
                            id="btnBuscar"
                            class="btn btn-primary w-100">
                        Buscar
                    </button>
                </div>

            </div>

        </div>
    </div>


    <!-- VENTAS DEL PERÍODO -->
    <h5 class="mb-3">Ventas del período seleccionado</h5>

    <div class="row g-3 mb-4">

        <!-- VENTAS CONFIRMADAS -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h6 class="text-muted">Ventas confirmadas</h6>

                    <h3 id="totalConfirmadas" class="text-success">
                        $0
                    </h3>

                    <small id="cantidadConfirmadas" class="text-muted">
                        0 operaciones
                    </small>

                </div>
            </div>
        </div>

        <!-- VENTAS ANULADAS -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">

                    <h6 class="text-muted">Ventas anuladas</h6>

                    <h3 id="totalAnuladas" class="text-warning">
                        $0
                    </h3>

                    <small id="cantidadAnuladas" class="text-muted">
                        0 operaciones
                    </small>

                </div>
            </div>
        </div>

    </div>


    <!-- =========================================
         GRÁFICO DE VENTAS
         ========================================= -->

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 id="tituloGrafico" class="mb-2">
                Ventas mensuales
            </h5>

            <p class="text-muted small">
                Montos de ventas confirmadas.
            </p>

            <div id="graficoVentas" class="grafico-ventas"></div>

        </div>
    </div>


    <!-- =========================================
         DETALLE DE VENTAS
         ========================================= -->

    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="mb-3">Detalle de ventas</h5>

            <div class="table-responsive"
                 style="max-height: 350px; overflow-y: auto;">

                <table class="table table-striped table-hover">

                    <thead>
                        <tr>
                            <th>N° Venta</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Estado</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>

                    <tbody id="tablaVentas"></tbody>

                </table>

            </div>

        </div>
    </div>

</div>


<!-- =========================================
     ESTILOS DEL GRÁFICO
     ========================================= -->

<style>
    .grafico-ventas {
        display: flex;
        align-items: flex-end;
        gap: 10px;
        height: 230px;
        overflow-x: auto;
        padding: 10px;
        border-bottom: 1px solid #ddd;
    }

    .grafico-item {
        flex: 1 0 30px;
        min-width: 30px;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-end;
    }

    .grafico-barra {
        width: 75%;
        background-color: #0d6efd;
        border-radius: 5px 5px 0 0;
    }

    .grafico-etiqueta {
        font-size: 12px;
        color: #6c757d;
        margin-top: 8px;
    }

    .grafico-vacio {
        align-items: center;
        justify-content: center;
        color: #6c757d;
    }
</style>


@section Scripts {
    <script src="~/js/dashboard.js"
            asp-append-version="true"></script>
}
